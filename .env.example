# FinLakeAmad — environment template.
# Copy to `.env` and replace every CHANGE_ME value. Never commit `.env`.

# --- SQL Server (primary PaySim source) ---
AMAD_MSSQL_PORT=1433
AMAD_MSSQL_SA_PASSWORD=CHANGE_ME_Str0ng!Pass

# --- PostgreSQL (secondary relational source) ---
AMAD_PG_PORT=5435
AMAD_PG_USER=amad_source
AMAD_PG_PASSWORD=CHANGE_ME
AMAD_PG_DB=amad_source

# --- MinIO object storage ---
AMAD_MINIO_API_PORT=9100
AMAD_MINIO_CONSOLE_PORT=9101
AMAD_MINIO_ROOT_USER=amad_admin
AMAD_MINIO_ROOT_PASSWORD=CHANGE_ME_min8chars
AMAD_LAKE_BUCKET=amad-lake

# --- Hive Metastore backing database ---
AMAD_METASTORE_DB_PORT=5436
AMAD_METASTORE_DB_USER=amad_hive
AMAD_METASTORE_DB_PASSWORD=CHANGE_ME
AMAD_METASTORE_DB_NAME=amad_metastore
AMAD_METASTORE_PORT=9083

# --- Trino ---
AMAD_TRINO_PORT=8088
