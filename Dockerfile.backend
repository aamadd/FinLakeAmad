# Multi-stage build for amad-control-plane (Spring Boot 3.3.5 / Java 21)
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY backend/pom.xml ./pom.xml
RUN mvn -B dependency:go-offline
COPY backend/src ./src
RUN mvn -B test package

# glibc-based JRE so DuckDB JNI native library loads cleanly
FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --retries=10 --start-period=25s \
  CMD bash -c '</dev/tcp/localhost/8000' || exit 1
ENTRYPOINT ["java", "-jar", "app.jar"]
