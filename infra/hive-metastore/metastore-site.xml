<?xml version="1.0" encoding="UTF-8"?>
<!-- Values use Hadoop ${env.VAR} substitution: no secret is stored in this file. -->
<configuration>
  <property><name>javax.jdo.option.ConnectionDriverName</name><value>org.postgresql.Driver</value></property>
  <property><name>javax.jdo.option.ConnectionURL</name><value>jdbc:postgresql://amad-metastore-db:5432/${env.AMAD_METASTORE_DB_NAME}</value></property>
  <property><name>javax.jdo.option.ConnectionUserName</name><value>${env.AMAD_METASTORE_DB_USER}</value></property>
  <property><name>javax.jdo.option.ConnectionPassword</name><value>${env.AMAD_METASTORE_DB_PASSWORD}</value></property>

  <property><name>metastore.thrift.port</name><value>9083</value></property>
  <property><name>metastore.warehouse.dir</name><value>s3a://${env.AMAD_LAKE_BUCKET}/warehouse/</value></property>
  <property><name>metastore.schema.verification</name><value>false</value></property>

  <property><name>fs.s3a.endpoint</name><value>http://amad-minio:9000</value></property>
  <property><name>fs.s3a.access.key</name><value>${env.AMAD_MINIO_ROOT_USER}</value></property>
  <property><name>fs.s3a.secret.key</name><value>${env.AMAD_MINIO_ROOT_PASSWORD}</value></property>
  <property><name>fs.s3a.path.style.access</name><value>true</value></property>
  <property><name>fs.s3a.connection.ssl.enabled</name><value>false</value></property>
  <property><name>fs.s3a.impl</name><value>org.apache.hadoop.fs.s3a.S3AFileSystem</value></property>
</configuration>
